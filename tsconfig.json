{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "types": [
      "node",
      "bun"
    ],
    "paths": {
      "@dev/util": ["./dev/util.ts"]
    }
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "./node_modules/",
    "./workers/",
    "./dist/",
    "./src/scripts/build/icons/**/*.js",
    "./src/scripts/build/out/**/*.js"
  ]
}
