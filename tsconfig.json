{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "types": [
      "node",
      "bun",
      "vite/client"
    ],
    "paths": {
      "@dev/util": ["./dev/util.ts"],
      "@/*": ["./src/*"],
      "@assets/*": ["./src/assets/*"],
      "@styles/*": ["./src/styles/*"],
      "@scripts/*": ["./src/scripts/*"],
      "@fonts/*": ["./src/pages/assets/fonts/*"],
      "@runtime": ["./src/scripts/runtime.ts"]
    }
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "./node_modules/",
    "./workers/",
    "./dist/",
    "./src/scripts/build/out/**/*.js"
  ]
}
