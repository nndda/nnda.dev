{
  "name": "nnda.dev",
  "description": "Unhingedly overengineered corner of the internet of nnda",
  "author": {
    "name": "nnda",
    "email": "talk@nnda.dev",
    "url": "https://nnda.dev"
  },
  "license": "AGPL-3.0-or-later",
  "os": [
    "linux"
  ],
  "private": true,
  "scripts": {
    "audit": "bun audit --ignore=GHSA-w3rx-r6r6-pgpr --ignore=GHSA-5p2g-fcmc-qvqq",
    "dev": "bun run start",
    "start": "bun run build:config && bun run build:data && concurrently 'webpack-dev-server --config ./config/webpack.dev.js --port 9000' 'bun run watch:data'",
    "build": "bun run build:config && bun run fetch:gh && bun run fetch:data-ext && bun run build:data && webpack --no-devtool --config ./config/webpack.config.js && bun run post:build",
    "build:data": "bun run --tsconfig-override=./config/tsconfig.build.json ./src/scripts/build/index.ts",
    "build:config": "tsc --project ./config/tsconfig.build.json",
    "watch:project": "ts-node ./src/_projects/project-pages.ts --watch",
    "watch:data": "bun run build:data -- --watching",
    "lint:styles": "stylelint --config ./config/.stylelintrc.json \"**/*.scss\"",
    "lint:scripts": "eslint --config ./config/eslint.config.ts .",
    "fetch:gh": "python ./src/api/gh.py",
    "fetch:data-ext": "python ./src/api/data-ext.py",
    "post:build": "python ./src/post/post_build.py && bun run --tsconfig-override=./config/tsconfig.build.json ./src/post/post-build.ts"
  },
  "engines": {
    "bun": "^1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@swc/html": "^1.16.2",
    "@types/bun": "^1.4.2",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/webpack": "^5.28.5",
    "autoprefixer": "^10.6.1",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "copy-webpack-plugin": "^14.0.0",
    "cron-parser": "^5.10.1",
    "css-loader": "^7.1.5",
    "cssnano": "^8.0.10",
    "dedent": "^1.7.2",
    "dotenv": "^18.0.1",
    "eslint": "^10.11.0",
    "feedsmith": "^3.0.0",
    "globals": "^17.12.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.9",
    "html-bundler-webpack-plugin": "^4.23.2",
    "image-size": "^2.0.4",
    "lefthook": "^2.1.14",
    "lodash": "^4.18.1",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "simple-icons": "^16.32.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "wrangler": "^4.135.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "esbuild": "^0.28.1",
    "fast-uri": "^4.1.2",
    "http-proxy-middleware": "^4.2.0",
    "immutable": "^5.1.9",
    "js-yaml": "^5.2.2",
    "launch-editor": "^2.14.1",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "shell-quote": "^1.10.0",
    "svgo": "^4.0.2",
    "undici": "^8.10.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  }
}
