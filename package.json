{
  "name": "nnda.dev",
  "description": "Unhingedly overengineered corner of the internet of nnda",
  "author": {
    "name": "nnda",
    "email": "talk@nnda.dev",
    "url": "https://nnda.dev"
  },
  "license": "AGPL-3.0-or-later",
  "os": [
    "linux"
  ],
  "private": true,
  "scripts": {
    "audit": "bun audit",
    "dev": "bun run start",
    "start": "bun build:data && bun build:pages && concurrently 'bunx --bun vite --config ./vite.config.mts' 'bun run watch:data'",
    "build": "bun fetch:gh && bun fetch:ext && bun build:data && bun build:pages && bunx --bun vite build --config ./vite.config.mts && bun run post:build",
    "build:data": "bun --bun run ./src/scripts/build/index.ts",
    "build:pages": "bun --bun run ./src/views/index.ts",
    "build:icons": "bun --bun run ./src/scripts/build/icons.ts",
    "build:illustrations": "bun --bun run ./src/scripts/build/illustrations.ts",
    "build:attributions": "bun --bun run ./src/scripts/build/attributions.ts",
    "build:fonts": "python ./src/scripts/build/fonts.py",
    "watch:project": "bun run ./src/_projects/project-pages.ts -- --watch",
    "watch:data": "bun run build:data -- --watching",
    "lint:styles": "stylelint --config ./config/.stylelintrc.json",
    "lint:scripts": "eslint --config ./config/eslint.config.ts",
    "fetch:gh": "bun --bun run ./src/data/get/gh.ts",
    "fetch:ext": "bun --bun run ./src/data/get/external.ts",
    "post:build": "python ./src/post/post_build.py && bun run ./src/post/post-build.ts"
  },
  "engines": {
    "bun": "^1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@swc/html": "^1.16.21",
    "@types/bun": "^1.4.4",
    "autoprefixer": "^10.6.2",
    "chokidar": "^6.0.0",
    "concurrently": "^10.0.6",
    "cssnano": "^9.9.0",
    "eslint": "^10.14.0",
    "feedsmith": "^3.0.1",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.10",
    "image-size": "^2.0.4",
    "lodash": "^4.18.1",
    "postcss": "^8.5.32",
    "sass-embedded": "^1.107.1",
    "simple-icons": "^16.36.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
