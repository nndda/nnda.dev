<section id="projects" data-nav-name="Projects">
  <div class="heading-left-sticky">
    <div class="jp">プロジェクト</div>
  </div>

  <div class="section-inner">
    <h1 class="heading-hr">
      Projects
    </h1>

    <ul class="project-items nostyle">
      {{#each data.projects }}
        {{#if this.id}}
          <li class="project card" data-name="{{this.id}}"></li>
        {{else}}
          <li class="project card" data-name="{{this.name}}"></li>
        {{/if}}
      {{/each}}
    </ul>
  </div>
</section>
