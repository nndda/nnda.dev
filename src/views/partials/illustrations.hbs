<section id="illustrations" data-nav-name="Illustrations" class="with-aside">
  <div class="heading-left-sticky">
    <div class="jp">イラスト</div>
    <div class="line"></div>
  </div>

  <div class="section-inner">

    <h1 class="heading-hr">
      Illustrations
    </h1>
    <p>
      Digital illustrations, OCs, some fanarts, and more OCs.
    </p>

    <ul class="illust-items nostyle">
      {{#each data.illusts.home }}
        <li class="illust-gall {{this.type}}">
          <ul class="illust-gall-inner nostyle">
            {{#each this.items }}
              <li class="illust">
                <figure>
                  <div class="img">
                    <img {{ imgSize this.src }} loading="lazy" alt="">
                  </div>

                  <figcaption>
                    <ul class="chr nostyle">
                      {{#each this.chr}}
                        <li>{{{this}}}</li>
                      {{/each}}
                    </ul>
                    {{{this.title}}}
                  </figcaption>
                </figure>
              </li>
            {{/each}}
          </ul>
        </li>
      {{/each}}
    </ul>

  </div>
</section>
