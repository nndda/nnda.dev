<section id="profile">
  <div class="bg-cover">
    <div class="section-inner">
      <div class="info-container">

        <div class="pfp-cont">
          <div class="profile-pict anim once fade float-up">
            <div class="img-cont">
              {{ img "./assets/avatar.avif" "" }}
            </div>

            <div class="status">
              <span>{{ author.status.icon }}</span>
              {{ author.status.text }}
            </div>
          </div>
        </div>

        <h1 class="author-name anim once fade float-right">
          {{ author.name }}
          <small>です~!</small>
        </h1>

        <div class="author-desc anim once fade float-up as-p">
          {{{ author.description }}}
        </div>

        <ul class="author-info nostyle">
          <li class="icon-text anim once">
            {{{ icon "profile" "volume-high" 20 20 }}}
            {{{ author.pronunciation }}}
          </li>

          <li class="icon-text anim once">
            {{{ icon "profile" "user-tag" 20 20 }}}
            {{{ author.pronouns }}}
          </li>

          <li class="icon-text anim once">
            {{{icon "profile" "clock" 20 20}}}
            <span id="clock-timezone" data-timezone="{{author.timezone}}">
              00:00:00
            </span>
          </li>

          <li class="icon-text anim once">
            {{{ icon "profile" "location-dot" 20 20 }}}
            {{{ author.location }}}
            <span>
            </span>
          </li>

          <li class="icon-text anim once">
            {{{ icon "profile" "language" 20 20 }}}
            {{{ author.languages }}}
          </li>

          <li
            class="icon-text anim once button"
            aria-label="More"
            role="button"
          >
            ...
          </li>
        </ul>

      </div>
    </div>
  </div>
</section>

{{ script "@/scripts/sections/profile.ts" true }}
