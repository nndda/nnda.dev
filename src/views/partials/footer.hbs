<footer>
  <div class="footer-body">
    <div class="links-section">
      <h1 class="footer-heading">nnda<code>.</code>dev</h1>
    </div>

    <ul class="links-section nostyle horizontal this-site">
      <li class="icon-text site-opt">
        {{{icon "footer" "scale-balanced" 16 16}}}
        <span>
          Licensed Under
          <a href="{{repoURL}}/blob/main/LICENSE"
            target="_blank"
            rel="nofollow noopener noreferrer"
            referrerpolicy="no-referrer"
            aria-label="GNU AGPLv3 license text link"
          >
            GNU AGPLv3
          </a>
          <br>
          <small>
            Source code only
          </small>
        </span>
      </li>

      {{#if buildCommitSHA}}
      <li class="icon-text site-opt">
        {{{icon "footer" "code-commit" 16 16}}}
        <span>
          Revision
          <a href="{{repoURL}}/commit/{{buildCommitSHAFull}}"
            target="_blank"
            rel="nofollow noopener noreferrer"
            referrerpolicy="no-referrer"
            aria-label="Build commit SHA"
          >
            <code>{{buildCommitSHA}}</code>
          </a>
          <br>
          <small>
            Last published
            <abbr id="last-published-label" title="{{releaseDate}}"></abbr>
          </small>
        </span>
      </li>
      {{/if}}

      <li class="icon-text site-opt">
        {{{icon "footer" "clock" 16 16}}}
        <span>
          Last updated
          <abbr id="last-updated-label" title="{{buildTimetamp}}"></abbr>
          <br>
          <small>
            Next update
            <abbr id="next-update-label" title="{{nextUpdateDate}}"></abbr>
          </small>
        </span>
      </li>
    </ul>

    <div class="links-section">
      <blockquote class="note">
        <div class="title">{{{icon "footer" "note-sticky" 16 16}}} Note</div>
        {{{site.note}}}
      </blockquote>
    </div>
  </div>

  <p class="package-info">
    This website is made possible with these awesome tech, projects, &amp; libraries 👇️
  </p>
<!--
  <div class="logos">
    <div class="inner">
      {{ img "/assets/KawaiiLogos/Node.js.webp" "Node.js" }}
      {{ img "/assets/KawaiiLogos/Cloudflare.webp" "Cloudflare" }}
      {{ img "/assets/KawaiiLogos/TypeScript.webp" "TypeScript" }}
    </div>
  </div>-->

  <div class="packages"><div class="inner"></div></div>

  <div class="footer-end">
    <div>
      Copyright &copy; {{year}} {{site.author}}{{#if allRightsReserved}}. All rights reserved.{{/if}}
    </div>
    <div class="flex-space"></div>
    <div>
      <a href="{{repoURL}}"
        target="_blank"
        rel="nofollow noopener noreferrer"
        referrerpolicy="origin"
      >
        {{{icon "footer" "code" 16 16}}} Source Code
      </a>
    </div>
  </div>
</footer>
